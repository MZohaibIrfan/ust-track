# Local Homebrew Postgres — no Docker, no hosted DB
# createdb hkust_planner
DATABASE_URL=postgresql+psycopg://localhost/hkust_planner

# FastAPI
CORS_ORIGINS=http://localhost:5173

# OpenRouter — LLM advisor (not implemented yet)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini

# Vite frontend (optional; leave empty to use the Vite /api proxy)
VITE_API_BASE=
