generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model School {
  id       String    @id @default(cuid())
  code     String    @unique
  name     String
  programs Program[]
}

model Program {
  id           String        @id @default(cuid())
  code         String        @unique
  name         String
  kind         String
  notes        String?
  school       School        @relation(fields: [schoolId], references: [id])
  schoolId     String
  requirements Requirement[]
  plans        Plan[]
}

model Course {
  id                 String              @id @default(cuid())
  code               String              @unique
  title              String
  credits            Int
  department         String
  description        String              @default("")
  isCommonCore       Boolean             @default(false)
  offerings          Offering[]
  requirementCourses RequirementCourse[]
  planCourses        PlanCourse[]
  prereqFor          Prerequisite[]      @relation("PrereqTarget")
  usedAsPrereq       Prerequisite[]      @relation("PrereqSource")
}

model Prerequisite {
  id         String @id @default(cuid())
  course     Course @relation("PrereqTarget", fields: [courseId], references: [id], onDelete: Cascade)
  courseId   String
  requires   Course @relation("PrereqSource", fields: [requiresId], references: [id], onDelete: Cascade)
  requiresId String
  groupKey   String @default("default")

  @@unique([courseId, requiresId])
}

model Term {
  id        String     @id @default(cuid())
  code      String     @unique
  label     String
  yearStart Int
  season    String
  offerings Offering[]
}

model Offering {
  id         String        @id @default(cuid())
  course     Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId   String
  term       Term          @relation(fields: [termId], references: [id], onDelete: Cascade)
  termId     String
  section    String
  instructor String        @default("")
  quota      Int?
  venue      String        @default("")
  meetings   MeetingTime[]

  @@unique([courseId, termId, section])
}

model MeetingTime {
  id         String   @id @default(cuid())
  offering   Offering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  offeringId String
  day        String
  startMin   Int
  endMin     Int
}

model Requirement {
  id          String              @id @default(cuid())
  program     Program             @relation(fields: [programId], references: [id], onDelete: Cascade)
  programId   String
  name        String
  kind        String
  minCredits  Int
  courses     RequirementCourse[]
}

model RequirementCourse {
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  requirementId String
  course        Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId      String

  @@id([requirementId, courseId])
}

model Plan {
  id         String         @id @default(cuid())
  name       String
  intakeYear Int
  declared   Boolean        @default(false)
  program    Program?       @relation(fields: [programId], references: [id])
  programId  String?
  semesters  PlanSemester[]
  createdAt  DateTime       @default(now())
}

model PlanSemester {
  id      String       @id @default(cuid())
  plan    Plan         @relation(fields: [planId], references: [id], onDelete: Cascade)
  planId  String
  year    Int
  season  String
  courses PlanCourse[]

  @@unique([planId, year, season])
}

model PlanCourse {
  semester   PlanSemester @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  semesterId String
  course     Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId   String

  @@id([semesterId, courseId])
}
